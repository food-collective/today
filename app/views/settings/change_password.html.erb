<% content_for :title, "Change admin password" %>
<main>
  <div class="wrap settings">
    <div>
      <%= link_to settings_path, class: "back" do %><%= icon(:back, size: 18) %> Back to settings<% end %>
      <%= render "shared/flash" %>
      <h1 class="page-title">Change admin password</h1>
    </div>

    <section class="card card--pad">
      <%= form_with url: update_password_path, method: :post do %>
        <div class="field">
          <%= label_tag :password, "Current password" %>
          <%= password_field_tag :password, nil, class: "input", autocomplete: "current-password" %>
        </div>
        <div class="field">
          <%= label_tag :new_password, "New password" %>
          <%= password_field_tag :new_password, nil, class: "input", autocomplete: "new-password" %>
        </div>
        <div class="field">
          <%= label_tag :new_password_confirmation, "Type the new password again" %>
          <%= password_field_tag :new_password_confirmation, nil, class: "input", autocomplete: "new-password" %>
        </div>
        <div class="form-actions">
          <%= button_tag "Change password", class: "btn btn--primary" %>
        </div>
      <% end %>
    </section>
  </div>
</main>
